# Copy this file to .env and fill in the values. Never commit .env.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Notion integration secret from notion.so/my-integrations
NOTION_TOKEN=

# Printed by `python -m scripts.setup_notion <page-url>`
NOTION_DATABASE_ID=

# Optional: only messages in this channel are read as tasks (right-click channel -> Copy Channel ID).
# Leave empty to use slash commands and DMs only.
TASK_CHANNEL_ID=

# Messages starting with this word become tasks in any channel, e.g. "c do cs 373 hw".
TRIGGER_WORD=c

# Optional: comma-separated Discord user IDs allowed to use the bot. Empty = anyone in the server.
ALLOWED_USER_IDS=

# Optional: your server ID, so slash commands show up instantly instead of after up to an hour.
GUILD_ID=

# Where the SQLite file lives. On Railway, point this at a mounted volume, e.g. /data
DATA_DIR=./data
